<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the saved API key out of cloud backups and phone-to-phone transfers on Android 12+ -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
